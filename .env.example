# ============================================================
#  Prym Signals — Environment Variables
#  Copy this file to `.env` and fill in the missing values.
#  See MISSING.md for where to obtain each credential.
# ============================================================

# --- Core ---
APP_ENV=dev
LOG_LEVEL=INFO
# Kill-switch: when true, no real orders are sent to Polymarket.
SIMULATION_MODE=true

# --- Database (PostgreSQL) ---
DATABASE_URL="postgresql://postgres.oiylebbfsveeotgddggj:Llop191919@19192412@aws-1-eu-west-3.pooler.supabase.com:6543/postgres?pgbouncer=true"

# --- Telegram ---
TELEGRAM_BOT_TOKEN=8646304516:AAHqK4KD0P7V1Ydzrc-PAUq8SiDStlWS2Vw
# Comma-separated list of Telegram user IDs allowed to use the bot.
ALLOWED_TELEGRAM_IDS=5005635872
# Subset allowed to run admin commands (/weights, /backtest, /secondary).
ADMIN_TELEGRAM_IDS=5005635872

# --- Mistral AI ---
MISTRAL_API_KEY=uAQNILYqlLjEV3etZP6JMwCQMsuS014O    
MISTRAL_MODEL=mistral-small-latest

# --- Polymarket / Polygon ---
# Wallet-first auth.  The bot only NEEDS the signer (WALLET_ADDRESS +
# WALLET_PRIVATE_KEY); the three POLYMARKET_API_* fields are auto-derived
# from the signer on first use (same flow as the official Polymarket
# SDKs via py-clob-client-v2.create_or_derive_api_key).  Set them by hand
# only if you want to pin a long-lived CLOB key.
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=
# Optional dashboard aliases.  If POLYMARKET_API_KEY / WALLET_ADDRESS
# are empty, these RELAYER_* values are picked up transparently.
RELAYER_API_KEY=
RELAYER_API_KEY_ADDRESS=
POLYGON_RPC_URL=https://polygon-rpc.com
WALLET_ADDRESS=
WALLET_PRIVATE_KEY=
# Browser-wallet users (MetaMask, Coinbase Wallet, Rabby...): Polymarket
# routes your trades through a Polygon Gnosis Safe proxy that *holds the
# USDC for you*.  Set the next two so the bot signs as the EOA but reads
# balances and trades against that proxy.  Leave blank for pure EOA.
#   0 = EOA  |  1 = Magic / Email proxy  |  2 = Browser-wallet Safe proxy (MetaMask)
POLYMARKET_SIGNATURE_TYPE=2
POLYMARKET_FUNDER_ADDRESS=

# --- News Ingestion ---
# Curated, follow-redirect-safe feeds covering politics + macro + crypto
# + sports, plus a "Twitter-like" tier:
#   * Truth Social Atom feed for Donald Trump (direct posts).
#   * Google News RSS searches for Elon Musk, Trump, Federal Reserve,
#     Bitcoin ETF, ceasefire/sanctions/war — these aggregate verified
#     outlets in near-real-time and surface what big accounts are
#     saying without needing the (paid) Twitter API.
# AP topnews + Politico picks were removed in 2026-04 — AP retired
# the URL (DNS dead) and Politico now returns 403 to bot user-agents.
RSS_FEEDS=https://feeds.bbci.co.uk/news/rss.xml,https://feeds.bbci.co.uk/news/world/rss.xml,https://feeds.bbci.co.uk/news/politics/rss.xml,https://rss.nytimes.com/services/xml/rss/nyt/HomePage.xml,https://rss.nytimes.com/services/xml/rss/nyt/Politics.xml,https://www.theguardian.com/world/rss,https://www.theguardian.com/us-news/rss,https://feeds.npr.org/1001/rss.xml,https://www.aljazeera.com/xml/rss/all.xml,https://thehill.com/feed/,https://feeds.bbci.co.uk/news/business/rss.xml,https://rss.nytimes.com/services/xml/rss/nyt/Business.xml,https://www.theguardian.com/uk/business/rss,https://feeds.marketwatch.com/marketwatch/topstories/,https://feeds.marketwatch.com/marketwatch/marketpulse/,https://www.cnbc.com/id/100003114/device/rss/rss.html,https://www.cnbc.com/id/10000664/device/rss/rss.html,https://feeds.a.dj.com/rss/RSSWorldNews.xml,https://finance.yahoo.com/news/rssindex,https://www.coindesk.com/arc/outboundfeeds/rss/?outputType=xml,https://cointelegraph.com/rss,https://www.theblock.co/rss.xml,https://decrypt.co/feed,https://bitcoinmagazine.com/.rss/full/,https://feeds.bbci.co.uk/sport/rss.xml,https://feeds.bbci.co.uk/sport/football/rss.xml,https://www.espn.com/espn/rss/news,https://www.espn.com/espn/rss/soccer/news,https://sports.yahoo.com/rss/,https://truthsocial.com/users/realDonaldTrump/feed.atom,https://news.google.com/rss/search?q=Elon+Musk&hl=en-US&gl=US&ceid=US:en,https://news.google.com/rss/search?q=Donald+Trump&hl=en-US&gl=US&ceid=US:en,https://news.google.com/rss/search?q=Federal+Reserve&hl=en-US&gl=US&ceid=US:en,https://news.google.com/rss/search?q=Bitcoin+ETF&hl=en-US&gl=US&ceid=US:en,https://news.google.com/rss/search?q=ceasefire+OR+sanctions+OR+war&hl=en-US&gl=US&ceid=US:en
NEWS_POLL_INTERVAL_SECONDS=45
NEWS_MAX_AGE_SECONDS=600
# Production keyword set — politics, macro, geopolitics, disasters,
# corporate shocks, crypto AND sports.  Every term matches case-
# insensitive against title + summary.  Wider net = more headlines
# reach the AI parser, where the actual classification happens.
HARD_FILTER_KEYWORDS=breaking,urgent,confirmed,announces,announced,declared,signed,vote,votes,election,referendum,impeach,impeached,indicted,charged,arrested,resign,resigned,ousted,sworn in,coup,war,ceasefire,invasion,invades,airstrike,missile,drone strike,nuclear,annexation,sanction,sanctions,embargo,hostage,rate cut,rate hike,fed,ecb,cpi,inflation,recession,default,bankruptcy,bankrupt,sec charges,fraud,ipo,earnings,layoffs,verdict,ruling,approved,rejected,ban,halt,shutdown,lawsuit,earthquake,hurricane,wildfire,tsunami,flood,storm,heatwave,blizzard,record temperature,record heat,record cold,crash,plunge,surge,soars,jumps,record high,record low,dies,died,killed,assassinated,explosion,shooting,attack,bitcoin,ethereum,btc,eth,crypto,etf,halving,stablecoin,hack,exploit,liquidation,delisted,listed,regulation,wins,beats,defeats,clinches,advances,eliminated,knockout,champion,championship,final,semi-final,quarter-final,title,upset,injured,suspended,transfer,signs,returns,barcelona,madrid,real madrid,manchester,liverpool,bayern,psg,nba,nfl,ufc,la liga,premier league,champions league,world cup,super bowl,playoff,playoffs

# --- Data Quality gate (v2) ---
# 55 keeps blog/medium noise out while letting Tier-2 outlets through
# (CoinDesk, ESPN, MarketWatch, BBC Sport).  Bump to 65 if you only
# want Tier-1 wires.
DQ_MIN_SCORE=55
DQ_CORROBORATION_WINDOW_MINUTES=30

# --- Strategy / Risk ---
# Sizing is **% of balance** per confidence band (see BAND_*_PCT below).
# DEFAULT_RISK_PCT is a per-user ceiling on that percentage — setting it
# below a band's % caps the trade; it never widens the band.  Default 3
# matches the high band, so out-of-the-box AUTO uses the full band.
DEFAULT_RISK_PCT=3
MIN_TRADE_USD=2
MAX_TRADE_USD=10
HIGH_CONFIDENCE_MAX_USD=25
MAX_OPEN_TRADES=5
MAX_TRADES_PER_DAY=8
TRADE_COOLDOWN_SECONDS=600
# Per-market re-entry cooldown (anti-whipsaw): after closing a trade on
# market X we refuse to re-open on X for this long, so a quick exit +
# re-chase loop can't turn a winner into a round-trip loss.
POST_CLOSE_REENTRY_SECONDS=1800
STOP_LOSS_PCT=10
TAKE_PROFIT_PCT=15
# Hard cap/floor on the traded outcome mid (AUTO + Telegram BUY).
# ``MAX_ENTRY_PRICE`` is an alias for ``ENTRY_MAX_PRICE`` — define only ONE.
#
# Objetivo: tickets baratos/medios (precio implícito del token comprado)
# entre ENTRY_MIN_PRICE (p.ej. 0.001 = 0.1%) y ENTRY_MAX_PRICE (0.40 = 40%).
# Por encima de eso descartamos (tails 85-98%).
ENTRY_MAX_PRICE=0.40
ENTRY_MIN_PRICE=0.001
# true = aplasta ENTRADA con ENTRY_* y MIN/MAX_IMPLIED_PROB en news + Telegram.
# false = mismo comportamiento viejo antes del gate (más fills en YES caro).
ENTRY_PRICE_GATE_ENABLED=true
ENTRY_IMPLIED_SCALE_ENABLED=true
ENTRY_SIZE_SCALE_AT_MIN=0.65
ENTRY_SIZE_SCALE_AT_MAX=1.2
#
# Opcional — probabilidad implícita ≈ precio del token que compras (0–1).
# - MIN_IMPLIED_PROB — evita entradas demasiado "polvo" (ej. sube el suelo
#   efectivo sobre ENTRY_MIN_PRICE; si usas 0.05 no entras por debajo de 5¢).
# - MAX_IMPLIED_PROB sólo tiene sentido si subes ENTRY_MAX por encima de 0.40.
# MIN_IMPLIED_PROB=0.05
# MAX_IMPLIED_PROB=0.85

# --- Opcional: aún más agresivo (más fills) ---
# MIN_EDGE_PCT=0.8
# MIN_FILL_RATIO=0.08
ALERT_SCORE_THRESHOLD=60
AUTO_SCORE_THRESHOLD=75
AUTO_URGENCY_THRESHOLD=8

# --- Scoring thresholds (DEPRECATED under edge-first refactor) ---
# These two thresholds no longer gate trades.  The 0-100 composite score
# is cosmetic only; the real gate is the hard conjunction below
# (Z_MIN_FOR_TRADE, MIN_EDGE_PCT, MAX_NEWS_AGE_FOR_TRADE, phase ∈ {1,2},
# direction != neutral, MIN_FILL_RATIO).  Kept for UI fallback.
SCORE_THRESHOLD_ALERT=60
SCORE_THRESHOLD_TRADE=75
TELEGRAM_SIGNAL_MIN_SCORE=20
TELEGRAM_SIGNAL_MIN_URGENCY=2

# --- Hard edge gates (CORE profile; price > LOW_PROB_ENTRY_PRICE) ---
# freshness, phase, |z| >= Z_MIN (0 = disabled), edge >= MIN_EDGE_PCT,
# fill >= MIN_FILL_RATIO.  Neutral impact still gated elsewhere.
Z_MIN_FOR_TRADE=0.0
MAX_NEWS_AGE_FOR_TRADE=600
MIN_FILL_RATIO=0.05

# --- LOW-PROB profile ---
LOW_PROB_ENTRY_PRICE=0.15
LOW_PROB_Z_MIN=0.0
LOW_PROB_MIN_EDGE_PCT=0.5

# --- Confidence bands (% of balance) ---
# Each band commits a fraction of the user's balance.  With HARD_SL at
# -30 %, a ``high`` trade risks ~0.9 % of equity.  ``low_prob`` is a
# tiny bucket reserved for cheap entries (price <= LOW_PROB_ENTRY_PRICE)
# — small stake, unbounded upside via the partial-TP ladder + trailing
# runner in the exit machine.
BAND_LOW_PROB_PCT=0.5
BAND_LOW_PCT=1
BAND_MID_PCT=2
BAND_HIGH_PCT=3

# --- Microstructure / cost model ---
MICROSTRUCTURE_MAX_SPREAD=0.06
# 2.0 % default favours frequency.  Edge stacks: trailing stop + partial
# TPs amplify winners while keeping losers small — hence "win big, lose
# small" with a modest per-trade EV requirement.
MIN_EDGE_PCT=0.5
POLYMARKET_FEE_PCT=0.0

# --- Timing / Price sampler ---
PRICE_SAMPLER_INTERVAL_SECONDS=60
PRICE_SAMPLER_MAX_MARKETS=100
MARKET_PRICE_CACHE_TTL=10
# How long to cache the on-chain USDC balance (seconds).  A short TTL
# keeps the number fresh enough for sizing decisions while avoiding RPC
# spam.  The bot auto-sizes against this value.
USDC_BALANCE_CACHE_TTL=60

# --- Market universe (Polymarket-first matching) ---
# The bot keeps an in-memory snapshot of the top N active Polymarket
# markets ranked by 24-h volume.  News is matched against this universe
# FIRST (in-memory, no API call); Gamma text-search is only used as a
# fallback for niche markets outside the top.  This eliminates the "AI
# invented a market that doesn't exist" failure mode.
MARKET_UNIVERSE_ENABLED=true
MARKET_UNIVERSE_SIZE=300
# 90 s catches newly-listed markets within ~1-2 minutes of breaking
# news, while still respecting Gamma rate limits.
MARKET_UNIVERSE_REFRESH_SECONDS=90

# --- News→market matching gates (HARD vetoes BEFORE ranking) ---
# These three deterministic vetoes prevent the matcher from routing a
# headline to an irrelevant market just because they share a generic
# token like "win" — the failure mode that produced "London Marathon →
# FIFA World Cup, confidence=0.238" in production logs.
#
#   * MATCH_MIN_CONFIDENCE — final score floor.  0.30 keeps the long
#     tail of borderline-but-real matches; raise to 0.40+ if you want
#     fewer trades with higher conviction.
#   * MATCH_REQUIRE_ENTITY_HIT — when the AI extracted entities from
#     the news, demand at least one to appear in the candidate
#     market's question.  Set to false ONLY for debugging.
#   * MATCH_NO_ENTITY_JACCARD_MIN — fallback Jaccard floor when the
#     AI returned no entities.  Without this, generic headlines route
#     anywhere.
#   * MATCH_ENFORCE_TOPIC_GATE — infer each market's topic
#     (sports/crypto/political/economic/geopolitical/climate) and
#     reject candidates whose topic is incompatible with the AI news
#     category.  false = más matches (revisa logs si hay falsos positivos).
MATCH_MIN_CONFIDENCE=0.02
MATCH_REQUIRE_ENTITY_HIT=false
MATCH_NO_ENTITY_JACCARD_MIN=0.02
MATCH_ENFORCE_TOPIC_GATE=false

# --- Pending-news retry (don't drop fresh news without a market) ---
# When an AI-tagged news item arrives but Polymarket hasn't listed the
# matching market yet, the bot keeps it alive for up to TTL seconds and
# retries matching on every universe refresh.  This is the "no rendirse"
# loop that turns "missed by 90 s" into "entered at the early price".
PENDING_NEWS_ENABLED=true
PENDING_NEWS_TTL_SECONDS=900
PENDING_NEWS_RETRY_INTERVAL_SECONDS=60
PENDING_NEWS_MAX_SIZE=200

# --- Market Intelligence feature layer (advisory only, OFF by default) ---
# When enabled, the bot fuses real-time microstructure, price momentum
# and whale-wallet flow into:
#   * market_context_score  (0..100, observational)
#   * edge_adjustment_score (± MI_MAX_EDGE_ADJUSTMENT_PCT pp)
# The adjustment is ADDED to net_edge_pct before the scorer's hard
# gates — it never replaces scoring, sizing or risk management.  Set a
# sub-weight to 0 to disable that single module.
MARKET_INTELLIGENCE_ENABLED=false
MI_MAX_EDGE_ADJUSTMENT_PCT=2.0
MI_WEIGHT_MICROSTRUCTURE=0.4
MI_WEIGHT_MOMENTUM=0.4
MI_WEIGHT_WHALES=0.2
MI_WHALE_UNUSUAL_USD=20000
MI_WHALE_FLOW_SATURATION_USD=50000
MI_MOMENTUM_WINDOW_MINUTES=15
MI_WHALE_LOOKBACK_MINUTES=120

# --- Latency / Concurrency ---
PIPELINE_CONCURRENCY=4

# --- Trailing stop (sole protective exit on losses) ---
# Arms when trade PnL reaches TRAILING_ACTIVATION_PCT (e.g. +40 %), then
# exits if price falls TRAILING_PCT (e.g. -20 %) from the running peak.
# A trade that only spikes +20 % never arms the trail; a trade that
# reaches +50 % and gives back 20 % from peak takes profit on the exit.
TRAILING_ACTIVATION_PCT=40
TRAILING_PCT=20
HARD_SL_PCT=30
# true = corta de inmediato si PnL <= -HARD_SL_PCT. false (recomendado cola)
# espera a armar trailing en +TRAILING_ACTIVATION_PCT o time exit.
HARD_SL_ALLOW_IMMEDIATE=false
# Vacío = sin parciales automaticos; sólo trailing desde +40 y time exit.
PARTIAL_TP_TIERS=

# --- Feedback loop (edge-first constrained) ---
# Only ``mispricing`` and ``liquidity`` pillars are learnable — ``news``
# and ``timing`` are hard gates and never move.  LR and clip are tight
# to avoid overfitting on small sample sizes.  No updates apply until
# FEEDBACK_MIN_TRADES closed trades with feature vectors exist.
FEEDBACK_LR=0.005
FEEDBACK_CLIP_LOW=0.85
FEEDBACK_CLIP_HIGH=1.15
FEEDBACK_MIN_TRADES=30

# --- Secondary markets (DEPRECATED) ---
# SecondaryMarketsScout is deprecated under the edge-first refactor —
# its mispricing-scout use case is covered by the unified news and
# cluster pipelines.  Keep SECONDARY_ENABLED=false.  Flipping it true
# triggers a deprecation warning and the handler is a no-op.
SECONDARY_ENABLED=false
SECONDARY_MAX_TRADES_PER_DAY=2
SECONDARY_SCAN_INTERVAL_SECONDS=600
SECONDARY_KEYWORDS=weather,temperature,snow,rain,hurricane,earthquake

# --- Top-Trader Analysis ---
TRADER_REFRESH_INTERVAL_SECONDS=300
TRADER_CONVICTION_USD=5000
TRADER_LOOKBACK_MINUTES=120

# --- Wallet whitelist (comma-separated 0x… addresses) ---
# Leave empty to auto-track the public Polymarket leaderboard.  When
# set, only these wallets are tracked and the leaderboard is ignored.
# Used to "copy" specific whales when news aligns with their positions.
TRACKED_WALLETS=

# --- Trade Monitor ---
TRADE_MONITOR_INTERVAL_SECONDS=30

# --- Wallet-cluster scanner (smart-money follow / soft copy-trade) ---
# When >= CLUSTER_MIN_WALLETS distinct tracked wallets enter the same
# (market, side) within CLUSTER_WINDOW_HOURS with combined size >=
# CLUSTER_MIN_CONVICTION_USD, the scanner treats it as a cluster signal
# and routes it through the same edge-first pipeline that processes
# news catalysts (microstructure + mispricing + timing + edge gate).
# This is "soft copy trading": you don't blindly mirror an individual
# whale, but when N whales agree AND the order book confirms an edge,
# you trade their direction.  Set CLUSTER_WATCH_ONLY=true to disable
# the auto-trade leg and only get Telegram alerts.
#
# With a small TRACKED_WALLETS whitelist (e.g. 2 wallets), the
# scanner auto-clamps CLUSTER_MIN_WALLETS to the whitelist size, so
# the trade fires only when EVERY tracked wallet agrees — a strong
# convergence signal.
CLUSTER_ENABLED=true
CLUSTER_WATCH_ONLY=false
CLUSTER_MIN_WALLETS=2
CLUSTER_WINDOW_HOURS=2
CLUSTER_MIN_CONVICTION_USD=500
CLUSTER_SCAN_INTERVAL_SECONDS=180
CLUSTER_DEDUP_TTL_SECONDS=3600
CLUSTER_MAX_CANDIDATES_PER_SCAN=8
CLUSTER_MAX_TRADES_PER_DAY=3

# --- Housekeeping (DB retention) ---
HOUSEKEEPING_INTERVAL_SECONDS=86400
NEWS_SEEN_RETENTION_DAYS=7
EXPIRED_SIGNAL_RETENTION_DAYS=30
PRICE_HISTORY_RETENTION_DAYS=60
TRADER_POSITIONS_RETENTION_DAYS=7

# --- Crypto Mode (BTC 5m/1h/1d lag-arb pipeline) ----------------------
# Independent engine activated per-user via /mode -> CRYPTO.  Ignores
# the news/cluster pipelines: spot from Binance/Coinbase WebSockets is
# priced against new Polymarket BTC binaries with a Black-Scholes N(d2)
# digital model; TA may gate entries (set min confluence 0 per horizon to
# disable); news is sentiment overlay / rare veto on 1h/1d.
CRYPTO_MODE_ENABLED=true
# Minimum NET edge after fees+slippage (lower = more fills).
CRYPTO_MIN_EDGE_PCT=0.5
CRYPTO_FEE_BPS=180
CRYPTO_SLIPPAGE_BPS=60
# Sizing anchors.  27 % is the user-stated first entry but the actual
# size = min(anchor, quarter-Kelly, per-trade cap, concurrent cap) so a
# weak edge never deploys 27 %.  CRYPTO_FLOOR_MIN_TICKET bumps Kelly to
# MIN_TRADE_USD when it would otherwise be dust (after edge gate).
# Late scoop fires at extreme imbalance in the last minute.
CRYPTO_FIRST_ANCHOR_PCT=27
CRYPTO_LATE_ANCHOR_PCT=1.5
CRYPTO_PER_TRADE_CAP_PCT=12
CRYPTO_CONCURRENT_CAP_PCT=45
CRYPTO_KELLY_FRACTION=0.25
CRYPTO_FLOOR_MIN_TICKET=true
# --- Long-shot mode (gambler's bias) ---
CRYPTO_LONGSHOT_ENABLED=true
CRYPTO_LONGSHOT_MAX_ASK=0.30
CRYPTO_LONGSHOT_MIN_EDGE_PCT=-3.0
CRYPTO_LONGSHOT_PER_TRADE_CAP_PCT=12
CRYPTO_LONGSHOT_ONLY=false
# TA floors (0..4); 0 = no TA gate for that horizon.
# Horizons the engine trades.  "all" or empty = 5m,1h,1d.
CRYPTO_HORIZONS_ENABLED=5m,1h,1d
CRYPTO_5M_MIN_CONFLUENCE=0
CRYPTO_1H_MIN_CONFLUENCE=1
CRYPTO_1D_MIN_CONFLUENCE=0
# When false, different BTC strikes can be open simultaneously even when
# their question slugs coincide (e.g. "above 80k" + "above 82k").
CRYPTO_ENFORCE_SIMILAR_OPEN_CHECK=false
# Daily caps inside crypto only (ignored by MAX_TRADES_PER_DAY).  5 m has no
# per-day crypto cap beyond edge + CRYPTO_MAX_OPEN_TRADES.
CRYPTO_1H_MAX_TRADES=48
CRYPTO_DAILY_MAX_TRADES=12
# Concurrent OPEN crypto positions (news MAX_OPEN_TRADES does not count these).
CRYPTO_MAX_OPEN_TRADES=48
# Stale-feed watchdog (ms).  When both feeds are older than this, no
# new entry is opened until a fresh tick arrives.
CRYPTO_FEED_STALE_MS=10000
# Feed warm-up (samples and sigma update interval).  5 samples × 0.2 s
# = the bot starts trading ~1 s after start-up.
CRYPTO_FEED_WARMUP_SAMPLES=5
CRYPTO_SIGMA_INTERVAL_S=0.2
CRYPTO_PRICE_SOURCES=binance,coinbase
# 1-minute candle history for TA, refreshed every N seconds.
CRYPTO_TA_LOOKBACK_BARS=200
CRYPTO_TA_REFRESH_SECONDS=30
CRYPTO_SCANNER_INTERVAL_SECONDS=5
# News overlay (context only).  5 m markets ignore it; 1 h markets use
# it to nudge sizing +/- 25 %; 1 d markets veto on extreme contradiction.
CRYPTO_NEWS_OVERLAY_ENABLED=true
CRYPTO_NEWS_WINDOW_MINUTES=30
# Late-scoop trigger: implied price <= 0.05 OR >= 0.95 in the last 60 s.
CRYPTO_LATE_SCOOP_LOW_THRESHOLD=0.05
CRYPTO_LATE_SCOOP_HIGH_THRESHOLD=0.95
CRYPTO_LATE_SCOOP_WINDOW_SECONDS=60
# Exit suggestion (no auto-close): nudge user when edge inverts past
# this threshold so they can /close manually.
CRYPTO_EXIT_SUGGESTION_EDGE_PCT=-3.0
